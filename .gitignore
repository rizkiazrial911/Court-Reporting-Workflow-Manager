# ==========================================
# GLOBAL / SYSTEM FILES
# ==========================================
# Operating System artifacts
.DS_Store
Thumbs.db
desktop.ini

# IDE and Editor configurations
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# Log files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*


# ==========================================
# BACKEND SERVICES
# ==========================================
# Dependencies
backend/node_modules/

# Production build outputs
backend/dist/
backend/build/

# Local Environment secrets (CRITICAL: Never commit these!)
backend/.env

# Test coverage reports
backend/coverage/


# ==========================================
# FRONTEND APPLICATION
# ==========================================
# Dependencies
frontend/node_modules/

# Production build outputs (Vite uses dist, CRA uses build)
frontend/dist/
frontend/build/

# Frontend local env overrides
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local

# Local dev hosting configurations
frontend/.expo/
frontend/.next/